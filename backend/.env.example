PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Supabase connection strings (get from Supabase Dashboard → Settings → Database → Connection string)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-[REGION].pooler.supabase.com:5432/postgres"

# ── Twilio SMS (optional) ──────────────────────────────────────────────────────
# Get these from https://console.twilio.com → Account Info
# If left blank, SMS is silently skipped — queue still works fully without it.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx    # your Twilio number in E.164 format
